{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "marca",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/marca/logotipo.webp",
          "/marca/isotipo.webp",
          "/marca/isotipo-256.png",
          "/icons/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "posters-tmdb",
      "urls": ["https://image.tmdb.org/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 200, "maxAge": "7d" }
    },
    {
      "name": "imagenes-storage",
      "urls": ["https://*.supabase.co/storage/v1/object/public/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 100, "maxAge": "3d" }
    },
    {
      "name": "fuentes",
      "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 30, "maxAge": "30d" }
    }
  ]
}
